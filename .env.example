# --- Frontend (Vite ile bundle'a girer — YALNIZCA public değerler) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Yeni biçim; Dashboard -> Settings -> API Keys -> Publishable
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Legacy anon anahtari. Gecis bitince silinecek; yalnizca geriye donuk uyum icin.
VITE_SUPABASE_ANON_KEY=<anon-key>

# Geliştirmede subdomain simülasyonu: ?tenant=<subdomain> query param'ını etkinleştirir.
VITE_ALLOW_TENANT_OVERRIDE=true

# --- Yalnızca yerel araçlar / MCP (bundle'a GİRMEZ) ---
# .mcp.json bu değişkenleri ${VAR} ile okur; sır dosyaya yazılmaz.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
GITHUB_TOKEN=

# --- Test (e2e) ---
E2E_BASE_URL=http://localhost:5180

# NOT: SUPABASE_SERVICE_ROLE_KEY burada TUTULMAZ.
# Yalnızca Supabase Edge Function ortamında Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') ile okunur.
